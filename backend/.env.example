DATABASE_URL=postgresql://sepid:local-development-only@127.0.0.1:55432/sepid
SEPID_POSTGRES_PORT=55432
SEPID_POSTGRES_PASSWORD=local-development-only
PORT=55320
SMS_PROVIDER=mock
SMS_CONFIG_ENCRYPTION_KEY=
# For SMS.ir, set SMS_PROVIDER=smsir and configure the server-side API key and sending line.
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
# For IPPanel, configure its API key and an E.164 sender number assigned to this account.
IPPANEL_API_KEY=
IPPANEL_SENDER=
# For real Kavenegar sends, switch SMS_PROVIDER to kavenegar and set these on the server only.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
